{
  "name": "@canopy/chroma",
  "version": "0.0.14",
  "description": "Shared tailwind config, and styles for Canopy Design Systems",
  "license": "MIT",
  "author": "Canopy",
  "repository": {
    "type": "git",
    "url": "https://github.com/aatmix/aatmix-packages.git",
    "directory": "chroma"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design-system",
    "scss",
    "@canopy"
  ],
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./theme-provider": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.mjs",
      "require": "./dist/themes/index.js"
    },
    "./css/*": "./dist/css/*",
    "./preset": "./src/tailwind.css",
    "./themes": "./dist/css/themes/all.css",
    "./themes/blue": "./dist/css/themes/blue/light.css",
    "./themes/blue/light": "./dist/css/themes/blue/light.css",
    "./themes/blue/dark": "./dist/css/themes/blue/dark.css",
    "./scss": "./src/index.scss",
    "./scss/*": "./src/*",
    "./tailwind": "./src/tailwind.css",
    "./rtl": "./dist/css/rtl.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.0",
    "next": "^16.0.0",
    "sass": "^1.77.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "tailwindcss-rtl": "^0.9.0"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=17",
    "tailwindcss": "^4.0.0"
  }
}