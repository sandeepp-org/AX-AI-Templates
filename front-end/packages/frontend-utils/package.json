{
  "name": "@canopy/frontend-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Front-end utilities: the REST client and upload helpers",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "axios": "^1.21.0"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
