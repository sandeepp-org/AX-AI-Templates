{
  "name": "@canopy/frontend-utils",
  "version": "1.0.0",
  "description": "Frontend utilities with REST and gRPC client support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./grpc": {
      "types": "./dist/grpc/index.d.ts",
      "import": "./dist/grpc/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist src/grpc/generated",
    "proto:generate": "tsx ./scripts/generate-grpc-types.ts",
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15",
    "axios": "^1.13.2",
    "google-protobuf": "^4.0.1"
  },
  "devDependencies": {
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "grpc-tools": "^1.13.1",
    "ts-protoc-gen": "^0.15.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
