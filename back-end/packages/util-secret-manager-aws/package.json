{
  "name": "@util/secret-manager-aws",
  "version": "0.0.1",
  "description": "AWS Secrets Manager provider with singleton pattern. Fetches all secrets from AWS Secrets Manager",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "test": "jest --config ../../jest.config.cjs --testPathPatterns=\"packages/util-secret-manager-aws\" --forceExit",
    "test:watch": "jest --config ../../jest.config.cjs --testPathPatterns=\"packages/util-secret-manager-aws\" --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1164.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
