{
  "name": "@util/redis",
  "version": "0.1.0",
  "description": "Redis-backed token/session storage with typed helpers and robust connection lifecycle",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "test": "jest --config ../../jest.config.cjs --testPathPatterns=\"packages/util-redis\" --forceExit",
    "test:watch": "jest --config ../../jest.config.cjs --testPathPatterns=\"packages/util-redis\" --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {}
}
