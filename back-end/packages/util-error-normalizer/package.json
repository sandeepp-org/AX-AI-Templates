    "test:watch": "jest --config ../../jest.config.cjs --testPathPatterns=\"packages/util-error-normalizer\" --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
