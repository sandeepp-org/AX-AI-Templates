{
  "name": "@util/error-normalizer",
  "version": "0.1.0",
  "description": "Framework-agnostic error modeling and normalization utilities for Nexus apps and services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
