{
  "name": "app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "test": "jest --config ../jest.config.cjs --testPathPatterns=\"^app/\" --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@util/api-server": "workspace:*",
    "@util/error-normalizer": "workspace:*",
    "@util/jwt-tokens": "workspace:*",
    "@util/logger": "workspace:*",
    "@util/mongodb": "workspace:^",
    "@util/redis": "workspace:*",
    "@util/secret-manager-aws": "workspace:*",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "mongodb": "^6.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.0",
    "jest": "^30.2.0",
    "typescript": "^5.9.0"
  }
}
