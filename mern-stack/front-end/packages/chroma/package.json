{
  "name": "@canopy/chroma",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens: themes, the Tailwind preset and the theme provider",
  "type": "module",
  "files": [
    "dist",
    "src",
    "assets"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind": "./src/tailwind.css",
    "./themes": "./dist/css/themes/all.css",
    "./themes/blue/light": "./dist/css/themes/blue/light.css",
    "./themes/blue/dark": "./dist/css/themes/blue/dark.css",
    "./scss": "./src/index.scss",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "sass": "^1.108.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
